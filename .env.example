# ============================================================================
# PetroQuery — environment configuration template
# ============================================================================
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a real `.env` to source control (already covered by .gitignore).
#
# Required secrets MUST be set explicitly in production. The application
# refuses to start when APP_ENV=production and any of SECRET_KEY,
# DATABASE_URL, or CORS_ALLOWED_ORIGINS are missing.
# ============================================================================

# Environment name. Set to "production" to enforce strict secret handling.
APP_ENV=development

# ---- Required secrets -------------------------------------------------------
# Used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL DSN for the pgvector-enabled database.
DATABASE_URL=postgresql+asyncpg://santiago:password123@localhost:5432/petroquery_db

# ---- LLM / model providers --------------------------------------------------
# Groq API key (https://console.groq.com).
GROQ_API_KEY=

# Hugging Face token (only required for gated models).
HUGGINGFACE_TOKEN=

# Optional: OpenCode API key (legacy field, not used by the runtime).
OPENCODE_API_KEY=

# ---- Database verbosity -----------------------------------------------------
# When `true`, SQLAlchemy prints every executed statement to stdout.
DB_ECHO=false

# ---- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins. NEVER use "*" in production
# (the application refuses to start if you try).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Admin invite diagnostics ----------------------------------------------
# When `true`, the temporary password generated by /admin/invite is printed
# to stdout. MUST remain `false` in production. Only enable for local
# development when you need the password surfaced in the server log.
INVITE_LOG_TEMP_PASSWORD=false
